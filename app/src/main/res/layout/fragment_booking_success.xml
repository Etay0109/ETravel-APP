<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:layoutDirection="ltr"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/success_content_padding">

        <!-- Success Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/success_icon_size"
            android:layout_height="@dimen/success_icon_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/success_icon_margin_top"
            android:layout_marginBottom="@dimen/success_icon_margin_bottom"
            app:cardCornerRadius="@dimen/success_icon_corner_radius"
            app:cardElevation="@dimen/success_icon_elevation"
            app:cardBackgroundColor="#4CAF50">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/v"
                android:textColor="@color/white"
                android:textSize="@dimen/success_icon_text_size"
                android:gravity="center"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/booking_confirmed"
            android:textColor="#2C3E50"
            android:textSize="@dimen/success_title_text_size"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/success_title_margin_bottom" />

        <!-- Subtitle -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/your_flight_has_been_successfully_booked"
            android:textColor="#7B8FA3"
            android:textSize="@dimen/success_subtitle_text_size"
            android:gravity="center"
            android:layout_marginBottom="@dimen/success_subtitle_margin_bottom" />

        <!-- Booking Reference -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/confirmation_LBL_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="Booking #AB123456"
            android:textColor="#4A6EC8"
            android:textSize="@dimen/success_reference_text_size"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/success_reference_margin_bottom" />

        <!-- Booking Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/success_card_margin_bottom"
            app:cardCornerRadius="@dimen/success_card_corner_radius"
            app:cardElevation="@dimen/success_card_elevation"
            app:cardBackgroundColor="@color/white">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/success_card_inner_padding">

                <!-- Section Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flight Details"
                    android:textColor="#2C3E50"
                    android:textSize="@dimen/success_section_title_text_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/success_section_title_margin_bottom" />

                <!-- Destination -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_row_margin_bottom">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/success_row_icon_bg_size"
                        android:layout_height="@dimen/success_row_icon_bg_size"
                        app:cardCornerRadius="@dimen/success_row_icon_bg_corner_radius"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E3F2FD">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/success_row_icon_size"
                            android:layout_height="@dimen/success_row_icon_size"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_location_pin"
                            app:tint="#c82309" />

                    </androidx.cardview.widget.CardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/success_row_content_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/destination"
                            android:textColor="#B0BEC5"
                            android:textSize="@dimen/success_row_label_text_size" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/confirmation_LBL_destination"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Paris, France"
                            android:textColor="#2C3E50"
                            android:textSize="@dimen/success_row_value_text_size"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Departure Date -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_row_margin_bottom">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/success_row_icon_bg_size"
                        android:layout_height="@dimen/success_row_icon_bg_size"
                        app:cardCornerRadius="@dimen/success_row_icon_bg_corner_radius"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFEBEE">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/success_row_icon_size"
                            android:layout_height="@dimen/success_row_icon_size"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_calender"
                            app:tint="#E57373" />

                    </androidx.cardview.widget.CardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/success_row_content_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/departure"
                            android:textColor="#B0BEC5"
                            android:textSize="@dimen/success_row_label_text_size" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/confirmation_LBL_departure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="January 15, 2026"
                            android:textColor="#2C3E50"
                            android:textSize="@dimen/success_row_value_text_size"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Return Date -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_row_margin_bottom">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/success_row_icon_bg_size"
                        android:layout_height="@dimen/success_row_icon_bg_size"
                        app:cardCornerRadius="@dimen/success_row_icon_bg_corner_radius"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFEBEE">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/success_row_icon_size"
                            android:layout_height="@dimen/success_row_icon_size"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_calender"
                            app:tint="#E57373" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/success_row_content_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Return"
                            android:textColor="#B0BEC5"
                            android:textSize="@dimen/success_row_label_text_size" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/confirmation_LBL_return"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="January 22, 2026"
                            android:textColor="#2C3E50"
                            android:textSize="@dimen/success_row_value_text_size"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Airline -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_row_margin_bottom">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/success_row_icon_bg_size"
                        android:layout_height="@dimen/success_row_icon_bg_size"
                        app:cardCornerRadius="@dimen/success_row_icon_bg_corner_radius"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E8F5E9">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/success_row_icon_size"
                            android:layout_height="@dimen/success_row_icon_size"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_flight"
                            app:tint="#66BB6A" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/success_row_content_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Airline"
                            android:textColor="#B0BEC5"
                            android:textSize="@dimen/success_row_label_text_size" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/confirmation_LBL_airline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="El Al"
                            android:textColor="#2C3E50"
                            android:textSize="@dimen/success_row_value_text_size"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/success_divider_height"
                    android:background="#E0E7EF"
                    android:layout_marginVertical="@dimen/success_divider_margin_vertical" />

                <!-- Total Price -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/success_price_margin_top">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/success_row_icon_bg_size"
                        android:layout_height="@dimen/success_row_icon_bg_size"
                        app:cardCornerRadius="@dimen/success_row_icon_bg_corner_radius"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF3E0">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/success_row_icon_size"
                            android:layout_height="@dimen/success_row_icon_size"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_money_bag"
                            app:tint="#FFB74D" />

                    </androidx.cardview.widget.CardView>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/success_row_content_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_price"
                            android:textColor="#B0BEC5"
                            android:textSize="@dimen/success_row_label_text_size" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/confirmation_LBL_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="599$"
                            android:textColor="#4A6EC8"
                            android:textSize="@dimen/success_price_text_size"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

        <!-- Passenger Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/success_passenger_card_margin_bottom"
            app:cardCornerRadius="@dimen/success_card_corner_radius"
            app:cardElevation="@dimen/success_card_elevation"
            app:cardBackgroundColor="@color/white">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/success_card_inner_padding">

                <!-- Section Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passenger_information"
                    android:textColor="#2C3E50"
                    android:textSize="@dimen/success_section_title_text_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/success_section_title_margin_bottom" />

                <!-- Passenger Name -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_passenger_row_margin_bottom">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/success_passenger_icon_size"
                        android:layout_height="@dimen/success_passenger_icon_size"
                        app:srcCompat="@drawable/ic_user"
                        app:tint="#7B8FA3"
                        android:layout_marginEnd="@dimen/success_passenger_icon_margin_end" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/confirmation_LBL_passenger_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="John Doe"
                        android:textColor="#2C3E50"
                        android:textSize="@dimen/success_passenger_text_size" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Email -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/success_passenger_row_margin_bottom">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/success_passenger_icon_size"
                        android:layout_height="@dimen/success_passenger_icon_size"
                        app:srcCompat="@drawable/ic_email"
                        app:tint="#7B8FA3"
                        android:layout_marginEnd="@dimen/success_passenger_icon_margin_end" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/confirmation_LBL_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="john.doe@email.com"
                        android:textColor="#2C3E50"
                        android:textSize="@dimen/success_passenger_text_size" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Phone -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/success_passenger_icon_size"
                        android:layout_height="@dimen/success_passenger_icon_size"
                        app:srcCompat="@drawable/ic_phone"
                        app:tint="#7B8FA3"
                        android:layout_marginEnd="@dimen/success_passenger_icon_margin_end" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/confirmation_LBL_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="+972 50-123-4567"
                        android:textColor="#2C3E50"
                        android:textSize="@dimen/success_passenger_text_size" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

        <!-- Back to Home Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmation_BTN_home"
            android:layout_width="match_parent"
            android:layout_height="@dimen/success_home_btn_height"
            android:text="@string/back_to_home"
            android:textSize="@dimen/success_home_btn_text_size"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/success_home_btn_corner_radius"
            android:backgroundTint="#4A6EC8"
            app:elevation="@dimen/success_home_btn_elevation"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:layout_marginBottom="@dimen/success_home_btn_margin_bottom" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>
