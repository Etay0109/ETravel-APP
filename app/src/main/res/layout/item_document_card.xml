<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doc_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/doc_card_margin_bottom"
    android:layoutDirection="ltr"
    app:cardCornerRadius="@dimen/doc_card_corner_radius"
    app:cardElevation="@dimen/doc_card_elevation"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="@dimen/doc_card_stroke_width"
    app:strokeColor="#F0F4F8">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/doc_card_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/doc_icon_bg_size"
            android:layout_height="@dimen/doc_icon_bg_size"
            app:cardCornerRadius="@dimen/doc_icon_bg_corner_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F5F7FA">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/doc_icon_padding"
                android:src="@drawable/ic_upload"
                app:tint="#4A6EC8"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/doc_LBL_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/doc_name_margin_start"
            android:text="document_name.pdf"
            android:textColor="#1A2B48"
            android:textSize="@dimen/doc_name_text_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <FrameLayout
            android:id="@+id/doc_BTN_delete"
            android:layout_width="@dimen/doc_delete_btn_size"
            android:layout_height="@dimen/doc_delete_btn_size"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/doc_delete_icon_size"
                android:layout_height="@dimen/doc_delete_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444"/>
        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</com.google.android.material.card.MaterialCardView>
