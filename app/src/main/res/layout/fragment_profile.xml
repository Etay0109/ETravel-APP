<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:layoutDirection="ltr">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_LAY_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_top"
        android:elevation="@dimen/profile_header_elevation"
        android:paddingHorizontal="@dimen/profile_header_padding_horizontal"
        android:paddingVertical="@dimen/profile_header_padding_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/white"
            android:textSize="@dimen/profile_header_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/profile_LAY_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/profile_content_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/profile_card_corner_radius"
                app:cardElevation="@dimen/profile_card_elevation"
                app:cardBackgroundColor="@color/white">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/profile_card_inner_padding">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_IMG_avatar"
                        android:layout_width="@dimen/profile_avatar_size"
                        android:layout_height="@dimen/profile_avatar_size"
                        android:src="@drawable/ic_launcher_background"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/profile_LBL_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/profile_name_margin_top"
                        android:text="User Name"
                        android:textSize="@dimen/profile_name_text_size"
                        android:textStyle="bold"
                        android:textColor="#1A2B48"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/profile_LBL_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/profile_email_margin_top"
                        android:text="user@email.com"
                        android:textSize="@dimen/profile_email_text_size"
                        android:textColor="#6B7280"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_section_title_margin_top"
                android:layout_marginBottom="@dimen/profile_section_title_margin_bottom"
                android:text="Account Actions"
                android:textSize="@dimen/profile_section_title_text_size"
                android:textStyle="bold"
                android:textColor="#1A2B48"
                android:gravity="start" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_CARD_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/profile_upload_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/profile_upload_stroke_width"
                app:strokeColor="#E5E7EB"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/profile_upload_inner_padding">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/profile_upload_icon_size"
                        android:layout_height="@dimen/profile_upload_icon_size"
                        android:background="@drawable/bg_circle_light"
                        android:padding="@dimen/profile_upload_icon_padding"
                        android:src="@drawable/ic_upload"
                        app:tint="#4A6EC8" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/profile_upload_text_margin_start">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload Documents"
                            android:textSize="@dimen/profile_upload_title_text_size"
                            android:textStyle="bold"
                            android:textColor="#1A2B48" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_upload_subtitle_margin_top"
                            android:text="PDF, JPG or PNG"
                            android:textSize="@dimen/profile_upload_subtitle_text_size"
                            android:textColor="#6B7280" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/profile_LBL_documents_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_section_title_margin_top"
                android:layout_marginBottom="@dimen/profile_section_title_margin_bottom"
                android:text="Personal Documents"
                android:textSize="@dimen/profile_section_title_text_size"
                android:textStyle="bold"
                android:textColor="#1A2B48"
                android:gravity="start"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/profile_LAY_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_BTN_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/profile_logout_height"
                android:layout_marginTop="@dimen/profile_logout_margin_top"
                android:text="LOG OUT"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="@dimen/profile_logout_text_size"
                android:textColor="#EF4444"
                app:cornerRadius="@dimen/profile_logout_corner_radius"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#EF4444"
                app:strokeWidth="@dimen/profile_logout_stroke_width" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
