<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/booking_form_screen_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/booking_form_card_margin_vertical"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/booking_form_card_corner_radius"
                app:cardElevation="@dimen/booking_form_card_elevation"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/booking_form_inner_padding">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/booking_LBL_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/booking_form_title_margin_bottom"
                        android:text="@string/book_your_flight_label"
                        android:textColor="#1E3A5F"
                        android:textSize="@dimen/booking_form_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/booking_CV_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_summary_margin_bottom"
                        app:cardBackgroundColor="#F0F4F8"
                        app:cardCornerRadius="@dimen/booking_form_summary_corner_radius"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/booking_form_summary_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/booking_LBL_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="500$"
                                android:textColor="#4A6EC8"
                                android:textSize="@dimen/booking_form_price_text_size"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/booking_LBL_destination"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Flight to Paris"
                                android:textColor="#1E3A5F"
                                android:textSize="@dimen/booking_form_destination_text_size"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_price_label_margin_top"
                                android:text="@string/price"
                                android:textColor="#5A7A99"
                                android:textSize="@dimen/booking_form_price_label_text_size"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/booking_LBL_destination" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_section_title_margin_bottom"
                        android:text="@string/personal_information"
                        android:textColor="#1E3A5F"
                        android:textSize="@dimen/booking_form_section_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/first_name"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_first_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_fname"
                                    android:background="@null"
                                    android:hint="@string/first_name"
                                    android:inputType="textPersonName"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_fname"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_user"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/last_name"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_last_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_lname"
                                    android:background="@null"
                                    android:hint="@string/last_name"
                                    android:inputType="textPersonName"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_lname"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_user"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/id_number"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_id_number"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_id"
                                    android:background="@null"
                                    android:hint="@string/id_number"
                                    android:inputType="number"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_id"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_id_card"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/email_address"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_email"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_email"
                                    android:background="@null"
                                    android:hint="@string/email_address"
                                    android:inputType="textEmailAddress"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_email"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_email"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_email_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/phone_number"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_phone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_phone"
                                    android:background="@null"
                                    android:hint="@string/phone_number"
                                    android:inputType="phone"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_phone"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_phone"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_section_title_margin_bottom"
                        android:text="@string/flight_details"
                        android:textColor="#1E3A5F"
                        android:textSize="@dimen/booking_form_section_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/airline"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <AutoCompleteTextView
                                    android:id="@+id/booking_EDT_airline"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_airline"
                                    android:background="@null"
                                    android:hint="Select Airline"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_airline"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_flight"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/departure_date"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_departure_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_dep"
                                    android:background="@null"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:hint="@string/select_date"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_dep"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_calender"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/return_date"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_return_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_ret"
                                    android:background="@null"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:hint="@string/select_date"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_ret"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_calender"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_section_title_margin_bottom"
                        android:layout_marginTop="@dimen/booking_form_payment_section_margin_top"
                        android:text="@string/payment_information"
                        android:textColor="#1E3A5F"
                        android:textSize="@dimen/booking_form_section_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                        app:cardElevation="@dimen/booking_form_field_elevation">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/booking_form_field_padding">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/credit_card_number"
                                android:textColor="#1E3A5F"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/booking_form_field_inner_margin_top">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_card_number"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icon_card"
                                    android:background="@null"
                                    android:hint="@string/xxxx_xxxx_xxxx_xxxx"
                                    android:inputType="number"
                                    android:maxLength="16"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon_card"
                                    android:layout_width="@dimen/booking_form_field_icon_size"
                                    android:layout_height="@dimen/booking_form_field_icon_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_credit_card"
                                    app:tint="#5A7A99" />
                            </RelativeLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/booking_form_field_margin_bottom"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/booking_form_card_half_margin"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                            app:cardElevation="@dimen/booking_form_field_elevation">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/booking_form_field_padding">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cvv"
                                    android:textColor="#1E3A5F"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_cvv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@null"
                                    android:hint="@string/_123"
                                    android:inputType="numberPassword"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/booking_form_card_half_margin"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@android:color/white"
                            app:cardCornerRadius="@dimen/booking_form_field_corner_radius"
                            app:cardElevation="@dimen/booking_form_field_elevation">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/booking_form_field_padding">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/expiry_date"
                                    android:textColor="#1E3A5F"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/booking_EDT_expiry"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@null"
                                    android:hint="@string/mm_yy"
                                    android:inputType="number"
                                    android:textColor="#1E3A5F"
                                    android:textColorHint="#B0BEC5" />
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/booking_BTN_submit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/booking_form_submit_height"
                        android:layout_marginBottom="@dimen/booking_form_submit_margin_bottom"
                        android:backgroundTint="#4A6EC8"
                        android:text="@string/book_now"
                        android:textColor="@color/white"
                        android:textSize="@dimen/booking_form_submit_text_size"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/booking_form_submit_corner_radius"
                        app:elevation="@dimen/booking_form_submit_elevation" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/booking_OVERLAY_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/booking_LOTTIE_loading"
            android:layout_width="@dimen/booking_form_loading_size"
            android:layout_height="@dimen/booking_form_loading_size"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/loading_booking"
            app:lottie_loop="true" />

    </FrameLayout>

</FrameLayout>
